/**
\struct Graphics::STexture2D
\ingroup coretypes
\brief A 2D texture: pixels in memory (`Surface`, RGBA bytes) and, after Renderer::LoadTextureToVRam(), on the GPU (`LoadedGPUTexture`, `Sampler`). `Width` and `Height` are in pixels.

Load an image with `Filesystem::Importers::LoadFile<Graphics::STexture2D>(path)`, which converts it to `SDL_PIXELFORMAT_ABGR8888` (\src{src/Types/Graphics.cpp,51,73}). `LoadedTexture`, `UVCoords`, `WHCoords` and `RGBA` are not used by the renderer. Declared at \src{include/Types/Graphics.hpp,25,54}.
*/

/**
\struct Graphics::SSprite
\ingroup coretypes
\brief Which texture a sprite uses (`SpriteSheet`, an asset path) and which part of it: `UVCoords` (top-left) and `WHCoords` (size), as fractions of the texture.

Declared at \src{include/Types/Graphics.hpp,85,89}. Used by Components::FTexture2DComponent.
*/

/**
\struct Graphics::SSpriteSheet
\ingroup coretypes
\brief A texture divided into a grid (`GridSize`, `Padding`, `Offset`). Loaded like a texture; used by the editor's Sprite Sheet viewer. Declared at \src{include/Types/Graphics.hpp,78,83}.
*/

/**
\struct Graphics::SSpriteAnimation
\ingroup coretypes
\brief A list of sprites with a frame rate and a loop flag. Data only at this commit: nothing plays it.
*/

/**
\struct Graphics::SGraphicsShader
\ingroup coretypes
\brief Describes a GPU shader asset. Not used at this commit; the renderer loads its shaders directly.
*/

/**
\struct Graphics::STilemap
\ingroup coretypes
\brief A tileset: a texture plus its tile size (`GridX`, `GridY`) and tile count (`Columns`, `Rows`). Created by Graphics::LoadTilemap().
*/

/**
\fn TObjectPtr<STilemap> Graphics::LoadTilemap(const std::string& AssetPath, uint16_t GridX, int16_t GridY)
\ingroup coretypes
\brief Loads a texture and wraps it as a tileset with the given tile size. Defined at \src{src/Types/Graphics.cpp,34,46}.
*/

/**
\fn TObjectPtr<SLevel> World::GenerateLevel(const std::string& LevelAssetName, const std::string& LevelName)
\ingroup coretypes
\brief Builds a World::SLevel from an LDtk project (`LevelAssetName`, an asset path) and one of its separately saved levels (`LevelName`).

Defined at \src{src/Types/World.cpp,14,126}. See \ref coretypes for the file layout it expects.
*/

/**
\fn void World::SetCurrentLevel(const TObjectPtr<SLevel>& NewLevel)
\ingroup coretypes
\brief Remembers a level as the current one. Nothing else in the engine reads it; it is for your game code.
*/

/**
\fn TObjectPtr<SLevel> World::GetCurrentLevel()
\ingroup coretypes
\brief The level last passed to World::SetCurrentLevel(), or empty.
*/

/**
\struct World::SLevel
\ingroup coretypes
\brief A loaded level: its layers (back to front), the `PlayerStart` position and its name. Declared at \src{include/Types/World.hpp,56,60}.
*/

/**
\struct World::SLevelLayer
\ingroup coretypes
\brief One level layer: its tiles, IntGrid cells, tileset, grid size, offset and opacity. Declared at \src{include/Types/World.hpp,38,54}.
*/

/**
\struct World::STile
\ingroup coretypes
\brief One tile: where it goes in the world, where it comes from in the tileset, its flip and opacity.
*/

/**
\struct World::SGridTile
\ingroup coretypes
\brief One IntGrid cell: its value (`GridType`) and its rectangle in world units. Renderer::LoadLevel() treats value 1 as solid.
*/

/**
\struct World::SLevelObject
\ingroup coretypes
\brief Empty at this commit.
*/
