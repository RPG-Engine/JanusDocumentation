/**
\fn void ECS::Module()
\ingroup ecs
\brief Starts the ECS module: sets 8 worker threads, registers reflection for `std::string`, Filesystem::SSoftAssetPath and glm vectors, imports the built-in component modules and creates the `OnCollision` phase. Called by Engine::InitializePlugins().

Defined at \src{src/Gameplay/ECS/Module.cpp,31,59}.
*/

/**
\fn void ECS::TeardownModule()
\ingroup ecs
\brief Destroys the flecs world (`ecs_fini`). Called by Engine::TeardownPlugins(). Defined at \src{src/Gameplay/ECS/Module.cpp,61,64}.
*/

/**
\fn void ECS::UpdateEntities(const float& DeltaTime)
\ingroup ecs
\brief Runs every system once (`world.progress(DeltaTime)`). Engine::Run() calls it every frame; you don't need to.

Defined at \src{src/Gameplay/ECS/Module.cpp,79,82}.
*/

/**
\fn void ECS::SelectEntity(flecs::entity Entity)
\ingroup ecs
\brief Makes `Entity` the one the Entity Debugger shows. Defined at \src{src/Gameplay/ECS/Module.cpp,84,86}.
*/

/**
\fn flecs::entity ECS::GetSelectedEntity()
\ingroup ecs
\brief Returns the entity selected in the Entity Debugger (or with ECS::SelectEntity()). Defined at \src{src/Gameplay/ECS/Module.cpp,88,90}.
*/

/**
\var ECS::Phase::OnCollision
\ingroup ecs
\brief A pipeline phase that runs after `flecs::PostUpdate`, meant for collision checks. Valid after Engine::InitializePlugins(). Created at \src{src/Gameplay/ECS/Module.cpp,58}.
*/

/**
\def DEFINE_NEW_ECS_PHASE(PhaseName, AfterPhase)
\ingroup ecs
\brief Defines `ECS::Phase::PhaseName()`, a pipeline phase that runs after the flecs phase `flecs::AfterPhase`.

`AfterPhase` is a flecs phase name without the `flecs::` prefix, such as `PostUpdate` or `OnStore`. The phase is created the first time the function is called. Use it at global scope, then pass `ECS::Phase::PhaseName()` to a system's `.kind()`. Defined at \src{include/Gameplay/ECS/Module.hpp,5,14}.

\genexopen{ecs/ComponentsAndQueries.cpp,Phase}
\snippet ecs/ComponentsAndQueries.cpp phase
\endex
*/

/**
\def DEFINE_COMPONENT(ComponentName, ...)
\ingroup ecs
\brief Defines `struct Components::ComponentName` with the given #ECS_MEMBER fields, its reflection data, and an Entity Debugger panel.

Use inside `namespace Components`, then register it with #ECS_REGISTER_COMPONENT. Defined at \src{include/Gameplay/ECS/Components.hpp,88,93}.

\genexopen{ecs/Movement.cpp,Components}
\snippet ecs/Movement.cpp components
\endex
*/

/**
\def DEFINE_COMPONENT_NO_DEBUG(ComponentName, ...)
\ingroup ecs
\brief Like #DEFINE_COMPONENT, without the Entity Debugger panel. Register it with #ECS_REGISTER_COMPONENT_NO_DEBUG. Defined at \src{include/Gameplay/ECS/Components.hpp,100,102}.
*/

/**
\def DEFINE_COMPONENT_OVERRIDE_DEBUG(ComponentName, PreDebugDraw, PostDebugDraw, ...)
\ingroup ecs
\brief Like #DEFINE_COMPONENT, but the Entity Debugger panel calls `PreDebugDraw(ComponentName*)` before and `PostDebugDraw(ComponentName*)` after the automatic member widgets.

Declare both functions (and forward-declare the struct) before the macro. Defined at \src{include/Gameplay/ECS/Components.hpp,95,98}.

\genexopen{ecs/ComponentsAndQueries.cpp,Debug draw}
\snippet ecs/ComponentsAndQueries.cpp debug_draw
\endex
*/

/**
\def ECS_MEMBER(MemberType, MemberName, DefaultValue)
\ingroup ecs
\brief One field of a component: its type, name and default value. Only valid inside the `DEFINE_COMPONENT` macros.

Defined at \src{include/Gameplay/ECS/Components.hpp,61}.
*/

/**
\def ECS_REGISTER_COMPONENT(ComponentName, World)
\ingroup ecs
\brief Registers a #DEFINE_COMPONENT component with `World`: its reflection data and its Entity Debugger panel. Call after Engine::InitializePlugins().

Defined at \src{include/Gameplay/ECS/Components.hpp,54,56}.
*/

/**
\def ECS_REGISTER_COMPONENT_NO_DEBUG(ComponentName, World)
\ingroup ecs
\brief Registers a component's reflection data only. Use it for #DEFINE_COMPONENT_NO_DEBUG components. Defined at \src{include/Gameplay/ECS/Components.hpp,58,59}.
*/

/**
\def REGISTER_COMPONENT_DEBUGGER(ComponentClass)
\ingroup ecs
\brief Registers a component's Entity Debugger panel. #ECS_REGISTER_COMPONENT does this for you.

Defined at \src{include/Gameplay/ECS/Components.hpp,21,22}.
*/

/**
\def DEFINE_COMPONENT_DEBUGGER(ComponentClass, PreDrawFunction, PostDrawFunction)
\ingroup ecs
\brief Defines the Entity Debugger panel class for a component. Used by the `DEFINE_COMPONENT` macros; the editor uses it directly to give `FTransformComponent` a move gizmo (\src{include/Editor/EntityEditorTool.hpp,16}).
*/

/**
\struct Components::FTransformComponent
\ingroup ecs
\brief Where an entity is: `glm::vec3 Location`, `glm::vec3 Rotation`, `glm::vec3 Scale`.

For sprites, `Location.x/y` is the top-left corner in world units and `Rotation.x` the rotation in radians. `Location.z` and `Scale` are not used by the renderer. In the Entity Debugger it has a translate gizmo. Defined at \src{include/Gameplay/ECS/Modules/TransformModule.hpp,16,20}.
*/

/**
\struct Components::FBoundingBoxComponent
\ingroup ecs
\brief The area an entity takes up, for interaction and mouse hover (not collision): `Width`, `Height` and `Offset` from the transform. `Bounds` is unused.

Defined at \src{include/Gameplay/ECS/Modules/TransformModule.hpp,22,33}. See GameplayFramework::ActivateMouseStateSystem().
*/

/**
\struct Components::FCameraComponent
\ingroup ecs
\brief Makes its entity the camera. See \ref rendering_camera for how `CameraSize`, `CenterSize` and `Boundaries` work.

Defined at \src{include/Gameplay/ECS/Modules/GraphicsModule.hpp,23,27}.
*/

/**
\struct Components::FLightComponent
\ingroup ecs
\brief A 2D light at the entity's position plus `PositionOffset`. See \ref rendering_lights.

Defined at \src{include/Gameplay/ECS/Modules/GraphicsModule.hpp,15,21}.
*/

/**
\fn glm::vec2 Components::GetCameraMaxDistance(const FCameraComponent& Component)
\ingroup ecs
\brief Half the camera size minus half the centre size: how far the followed entity's position is from the view's top-left corner. Used by the camera system.
*/

/**
\struct Components::TransformModule
\ingroup ecs
\brief flecs module that registers Components::FTransformComponent and Components::FBoundingBoxComponent. Imported by ECS::Module().
*/

/**
\struct Components::GraphicsModule
\ingroup ecs
\brief flecs module that registers `SDL_FColor`, Components::FLightComponent and Components::FCameraComponent. Imported by ECS::Module().
*/

/**
\struct Components::GlmModule
\ingroup ecs
\brief flecs module that registers reflection data for `glm::vec2`, `glm::vec3` and `glm::vec4`. Imported by ECS::Module().
*/

/**
\class Components::ECSDebugFactory
\ingroup ecs
\brief Base of the Entity Debugger panel classes the component macros generate. Its `CreateComponentOnEntity` powers the debugger's *Add Component* button.
*/

/**
\fn template<typename TElementType> void Components::ECSDebug_DrawElement(const char* ElementName, TElementType* Element)
\ingroup ecs
\brief Draws one component member in the Entity Debugger. Specialize it to support another member type; the default draws nothing.
*/
