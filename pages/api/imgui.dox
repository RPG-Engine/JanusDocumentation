*/

/**
\fn void ImGuiWrapper::RegisterFactory(const std::string& Name, const TObjectPtr<ImGuiWrapper::DebugFactoryBase> &DebugFactory)
\ingroup imguiwrapper
\brief Registers (or replaces) the debug factory used to draw data named `Name`. Defined at \src{src/Editor/ImGuiWrapper/Module.cpp,26,28}.
*/

/**
\fn void ImGuiWrapper::DrawFactory_Container(const std::string& Name, void* ContainerPtr)
\ingroup imguiwrapper
\brief Draws the data at `ContainerPtr` with the factory registered as `Name`. Does nothing if there is none or the pointer is null. Defined at \src{src/Editor/ImGuiWrapper/Module.cpp,30,38}.
*/

/**
\fn TObjectPtr<DebugFactoryBase> ImGuiWrapper::GetFactory(const std::string& Name)
\ingroup imguiwrapper
\brief Returns the factory registered as `Name`, or an empty pointer.
*/

/**
\fn std::vector<std::string> ImGuiWrapper::GetFactoryNames()
\ingroup imguiwrapper
\brief Returns the names of all registered factories. The Entity Debugger lists them under *New Component*.
*/

